{
  "name": "@mcp/notion",
  "version": "1.0.0",
  "description": "MCP server + human CLI for common Notion page workflows, including rich pages and reusable templates.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-notion": "./dist/index.js",
    "notion": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "start": "node dist/index.js",
    "start:cli": "node dist/cli.js",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch --passWithNoTests",
    "test:ui": "vitest --ui --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^2.2.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "nock": "^13.5.4",
    "prettier": "^3.1.1",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "notion",
    "api",
    "claude-code"
  ],
  "author": "Fernando Taricano",
  "license": "MIT"
}
