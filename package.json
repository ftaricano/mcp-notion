{
  "name": "@mcp/notion",
  "version": "1.0.0",
  "description": "MCP server + human CLI for common Notion page workflows, including rich pages and reusable templates.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js",
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "mcp-notion": "./dist/index.js",
    "notion": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "start": "node dist/index.js",
    "start:cli": "node dist/cli.js",
    "clean": "rm -rf dist coverage *.tgz",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write README.md SECURITY.md package.json package-lock.json .github/workflows/ci.yml tests/integration/package-contract.test.ts",
    "format:check": "prettier --check README.md SECURITY.md package.json package-lock.json .github/workflows/ci.yml tests/integration/package-contract.test.ts",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "type-check": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^2.2.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "nock": "^13.5.4",
    "prettier": "^3.1.1",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "notion",
    "notion-api",
    "notion-cli",
    "api",
    "llm",
    "claude-code",
    "productivity"
  ],
  "author": "Fernando Taricano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftaricano/mcp-notion.git"
  },
  "bugs": {
    "url": "https://github.com/ftaricano/mcp-notion/issues"
  },
  "homepage": "https://github.com/ftaricano/mcp-notion#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
