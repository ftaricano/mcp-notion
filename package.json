{
  "name": "@mcp/notion",
  "version": "1.0.0",
  "description": "MCP server for common Notion page workflows, including rich pages and reusable templates.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-notion": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "@notionhq/client": "^2.2.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/ui": "^1.1.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "nock": "^13.5.4",
    "prettier": "^3.1.1",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "notion",
    "api",
    "claude-code"
  ],
  "author": "Fernando Taricano",
  "license": "MIT"
}