# Copy this file to .env for local development.
# Never commit .env or any file containing real Notion tokens.

# Required for live MCP/CLI calls.
# Use either an internal integration token or an OAuth access token.
# Leave blank in examples; do not paste a real token here.
NOTION_TOKEN=

# Optional runtime guardrails.
VALIDATE_TOKEN=true
MAX_REQUESTS_PER_MINUTE=60
ENABLE_AUDIT_LOG=true

# Comma-separated Notion page IDs, with or without hyphens.
ALLOWED_PAGE_IDS=
BLOCKED_PAGE_IDS=

# Optional parent page used by create_root_page.
NOTION_ROOT_PARENT_PAGE_ID=

# Compatibility alias for runtimes that prefer MCP-prefixed env names.
MCP_NOTION_ROOT_PARENT_PAGE_ID=
